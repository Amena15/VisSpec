            <span className={`px-4 py-2 rounded-lg border ${darkMode ? 'bg-slate-800 border-slate-700 text-text-secondary-dark' : 'bg-card border-slate-200 text-text-secondary'}`}>Python + spaCy</span>
            <span className={`px-4 py-2 rounded-lg border ${darkMode ? 'bg-slate-800 border-slate-700 text-text-secondary-dark' : 'bg-card border-slate-200 text-text-secondary'}`}>Mermaid.js + SQLite</span>
          </div>
        </div>
      </section>

      {/* Final CTA */}
      <section
        id="cta"
        className={`py-20 ${darkMode ? 'bg-gradient-to-b from-background-dark to-slate-800' : 'bg-gradient-to-b from-background to-blue-100'}`}
        style={{ opacity: isVisible.cta ? 1 : 0, transform: isVisible.cta ? 'translateY(0)' : 'translateY(20px)' }}
      >
        <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 className={`text-3xl font-bold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-6`}>Experience Automated Requirements Analysis</h2>
          <p className={`text-lg ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'} mb-8`}>
            Transform your requirements engineering workflow today
          </p>
          <Link
