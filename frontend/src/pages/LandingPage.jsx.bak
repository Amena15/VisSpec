import React, { useState, useEffect } from 'react';
import { ChevronRight, Upload, Search, Eye, CheckCircle, ArrowRight, AlertTriangle, RefreshCw, TrendingUp, Brain, FileText, BarChart3, Sun, Moon } from 'lucide-react';
import { Link } from 'react-router-dom';

const LandingPage = () => {
  const [isVisible, setIsVisible] = useState({});
  const [darkMode, setDarkMode] = useState(false);

  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          setIsVisible(prev => ({
            ...prev,
            [entry.target.id]: entry.isIntersecting
          }));
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('[id]').forEach(el => {
      observer.observe(el);
    });

    return () => observer.disconnect();
  }, []);

  const toggleDarkMode = () => {
    setDarkMode(!darkMode);
  };

  const capabilities = [
    {
      title: "Semantic Ambiguity Detection",
      description: "Automatically identifies unclear or inconsistent requirements"
    },
    {
      title: "Automated UML Generation",
      description: "Creates visual diagrams from textual specifications"
    },
    {
      title: "Complexity & Risk Analysis",
      description: "Estimates development effort and identifies risk factors"
    },
    {
      title: "AI-Assisted Refinement",
      description: "Suggests improvements to requirement quality"
    },
    {
      title: "Visual Traceability",
      description: "Links requirements to generated diagrams"
    },
    {
      title: "Role-Based Validation",
      description: "Different interfaces for analysts and supervisors"
    }
  ];

  const steps = [
    { icon: Upload, title: "Upload", desc: "Submit requirements document or paste text" },
    { icon: Search, title: "Analyze", desc: "AI processes text for semantics and structure" },
    { icon: Eye, title: "Visualize", desc: "Generate UML diagrams and visual models" },
    { icon: CheckCircle, title: "Validate", desc: "Review insights and metrics" }
  ];

  return (
    <div className="min-h-screen bg-background">
      {/* Hero Section */}
      <section
        id="hero"
        className={`py-20 relative overflow-hidden transition-all duration-1000 ${darkMode ? 'bg-gradient-to-b from-background-dark to-slate-800' : 'bg-gradient-to-b from-background to-blue-100'}`}
        style={{ opacity: isVisible.hero ? 1 : 0, transform: isVisible.hero ? 'translateY(0)' : 'translateY(20px)' }}
      >
        {/* Gradient overlay for futuristic touch */}
        <div className="absolute inset-0 bg-gradient-to-r from-primary/10 to-accent/10"></div>

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div className="flex flex-col lg:flex-row items-center">
            <div className="lg:w-1/2 text-center lg:text-left mb-12 lg:mb-0">
              <h1 className={`text-4xl md:text-5xl lg:text-6xl font-bold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-4`}>
                AI-Powered Requirements
              </h1>
              <h2 className={`text-2xl md:text-3xl lg:text-4xl font-bold ${darkMode ? 'text-primary/80' : 'text-primary'} mb-6`}>
                Analysis for Software Engineering
              </h2>
              <p className={`text-xl ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'} mb-8 max-w-2xl`}>
                Transform ambiguous requirements into clear visual specifications with automated analysis and diagram generation
              </p>
              <div className="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                <Link
                  to="/analysis"
                  className="btn-primary px-8 py-4 rounded-xl font-medium flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-transform"
                >
                  Analyze Requirements
                  <ArrowRight className="ml-2 h-5 w-5" />
                </Link>
                <Link
                  to="/visualization"
                  className="border-2 border-primary text-primary px-8 py-4 rounded-xl font-medium hover:bg-primary hover:text-white transition-colors"
                >
                  View Architecture
                </Link>
              </div>
            </div>
            <div className="lg:w-1/2 flex justify-center">
              {/* Abstract AI-themed illustration */}
              <div className="relative w-80 h-80">
                <div className="absolute inset-0 bg-gradient-to-r from-accent-primary to-accent-secondary rounded-full opacity-20 blur-xl animate-pulse"></div>
                <div className={`relative rounded-2xl shadow-xl p-6 w-full h-full flex items-center justify-center ${darkMode ? 'bg-surface-dark' : 'bg-card'}`}>
                  <div className="text-center">
                    <Brain className={`h-16 w-16 ${darkMode ? 'text-accent-primary' : 'text-accent-primary'} mx-auto mb-4`} />
                    <div className="space-y-2">
                      <div className={`h-3 ${darkMode ? 'bg-surface-dark' : 'bg-surface'} rounded-full w-3/4 mx-auto`}></div>
                      <div className={`h-3 ${darkMode ? 'bg-surface-dark' : 'bg-surface'} rounded-full w-1/2 mx-auto`}></div>
                      <div className={`h-3 ${darkMode ? 'bg-surface-dark' : 'bg-surface'} rounded-full w-5/6 mx-auto`}></div>
                      <div className={`h-3 ${darkMode ? 'bg-surface-dark' : 'bg-surface'} rounded-full w-2/3 mx-auto`}></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Dark mode toggle button */}
          <div className="absolute top-6 right-6">
            <button
              onClick={toggleDarkMode}
              className={`p-2 rounded-full ${darkMode ? 'bg-slate-700 text-text-primary-dark' : 'bg-surface text-primary'} shadow-md hover:shadow-lg transition-all`}
              aria-label="Toggle dark mode"
            >
              {darkMode ? <Sun className="h-5 w-5" /> : <Moon className="h-5 w-5" />}
            </button>
          </div>
        </div>
      </section>

      {/* The Challenge Section */}
      <section
        id="challenge"
        className={`py-16 ${darkMode ? 'bg-background-dark' : 'bg-surface'}`}
        style={{ opacity: isVisible.challenge ? 1 : 0, transform: isVisible.challenge ? 'translateY(0)' : 'translateY(20px)' }}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 className={`text-3xl font-bold text-center ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-12`}>The Challenge in Requirements Engineering</h2>
          <div className="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <p className={`text-lg ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'} mb-6`}>
                Traditional requirements documents often contain ambiguities, inconsistencies, and communication gaps that lead to project delays and cost overruns.
              </p>
              <p className={`text-lg ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>
                Manual validation and visualization processes are time-consuming and error-prone.
              </p>
            </div>
            <div className={`p-8 rounded-xl border ${darkMode ? 'bg-surface-dark border-slate-700' : 'bg-card border-slate-200'}`}>
              <ul className="space-y-6">
                <li className="flex items-start">
                  <AlertTriangle className={`h-6 w-6 ${darkMode ? 'text-warning' : 'text-warning'} mt-1 mr-4 flex-shrink-0`} />
                  <span className={`${darkMode ? 'text-text-primary-dark' : 'text-text-primary'}`}>Ambiguities that lead to misinterpretation</span>
                </li>
                <li className="flex items-start">
                  <RefreshCw className={`h-6 w-6 ${darkMode ? 'text-error' : 'text-error'} mt-1 mr-4 flex-shrink-0`} />
                  <span className={`${darkMode ? 'text-text-primary-dark' : 'text-text-primary'}`}>Inconsistencies that cause implementation errors</span>
                </li>
                <li className="flex items-start">
                  <ChevronRight className={`h-6 w-6 ${darkMode ? 'text-primary' : 'text-primary'} mt-1 mr-4 flex-shrink-0`} />
                  <span className={`${darkMode ? 'text-text-primary-dark' : 'text-text-primary'}`}>Communication gaps between stakeholders</span>
                </li>
                <li className="flex items-start">
                  <TrendingUp className={`h-6 w-6 ${darkMode ? 'text-success' : 'text-success'} mt-1 mr-4 flex-shrink-0`} />
                  <span className={`${darkMode ? 'text-text-primary-dark' : 'text-text-primary'}`}>Time-consuming manual validation processes</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* How It Works Section */}
      <section
        id="how-it-works"
