          <div className="flex justify-center">
            <div className={`border-2 ${darkMode ? 'border-slate-700' : 'border-slate-200'} rounded-xl overflow-hidden shadow-xl max-w-4xl w-full`}>
              <div className={`${darkMode ? 'bg-slate-800' : 'bg-card'} px-4 py-2 flex items-center`}>
                <div className="flex space-x-2">
                  <div className="w-3 h-3 bg-error rounded-full"></div>
                  <div className="w-3 h-3 bg-warning rounded-full"></div>
                  <div className="w-3 h-3 bg-success rounded-full"></div>
                </div>
              </div>
              <div className={`${darkMode ? 'bg-slate-800' : 'bg-surface'} p-8`}>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div>
                    <h3 className={`text-lg font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-4`}>Requirements Analysis</h3>
                    <div className="space-y-3">
                      <div className="flex items-center">
                        <div className="w-3 h-3 bg-success rounded-full mr-2"></div>
                        <span className={`${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>No ambiguities detected</span>
                      </div>
                      <div className="flex items-center">
                        <div className="w-3 h-3 bg-warning rounded-full mr-2"></div>
                        <span className={`${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>Potential inconsistencies flagged</span>
                      </div>
                      <div className="flex items-center">
                        <div className="w-3 h-3 bg-primary rounded-full mr-2"></div>
                        <span className={`${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>Complexity score: Medium</span>
                      </div>
                    </div>
                  </div>
                  <div>
                    <h3 className={`text-lg font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-4`}>Generated Diagram</h3>
                    <div className={`border rounded-lg p-4 h-32 flex items-center justify-center ${darkMode ? 'bg-slate-800 border-slate-700' : 'bg-card border-slate-200'}`}>
                      <div className="text-center">
                        <div className="inline-block p-2 bg-accent-primary/10 rounded-lg">
                          <BarChart3 className={`h-10 w-10 ${darkMode ? 'text-accent-primary' : 'text-accent-primary'}`} />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Solution Overview */}
      <section
        id="solution"
        className={`py-16 ${darkMode ? 'bg-slate-800' : 'bg-card'}`}
        style={{ opacity: isVisible.solution ? 1 : 0, transform: isVisible.solution ? 'translateY(0)' : 'translateY(20px)' }}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 className={`text-3xl font-bold text-center ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-12`}>Automated Requirements Analysis</h2>
          <div className="text-center max-w-3xl mx-auto">
            <p className={`text-lg ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'} mb-8`}>
              VisSpec leverages AI-powered semantic analysis to identify ambiguities, generate visual models, and provide complexity metrics that accelerate the requirements validation process.
            </p>
          </div>
        </div>
      </section>

      {/* Key Capabilities */}
      <section
        id="capabilities"
        className={`py-16 ${darkMode ? 'bg-background-dark' : 'bg-surface'}`}
        style={{ opacity: isVisible.capabilities ? 1 : 0, transform: isVisible.capabilities ? 'translateY(0)' : 'translateY(20px)' }}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 className={`text-3xl font-bold text-center ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-12`}>Key Capabilities</h2>
          <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {capabilities.map((capability, index) => (
              <div key={index} className={`p-6 rounded-xl hover:shadow-md transition-shadow border ${darkMode ? 'bg-surface-dark border-slate-700' : 'bg-card border-slate-200'}`}>
                <h3 className={`text-lg font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-2`}>{capability.title}</h3>
                <p className={`${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>{capability.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Intended Users */}
      <section
        id="users"
        className={`py-16 ${darkMode ? 'bg-slate-800' : 'bg-card'}`}
        style={{ opacity: isVisible.users ? 1 : 0, transform: isVisible.users ? 'translateY(0)' : 'translateY(20px)' }}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 className={`text-3xl font-bold text-center ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-12`}>For Students & Professionals</h2>
          <div className="grid md:grid-cols-2 gap-8">
            <div className={`p-8 rounded-xl border shadow-sm ${darkMode ? 'bg-surface-dark border-slate-700' : 'bg-surface border-slate-200'}`}>
              <h3 className={`text-xl font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-4`}>Students/Analysts</h3>
              <ul className={`space-y-2 ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>
                <li>• Learn requirements engineering with AI assistance</li>
                <li>• Practice with automated analysis tools</li>
                <li>• Understand ambiguity detection</li>
              </ul>
            </div>
            <div className={`p-8 rounded-xl border shadow-sm ${darkMode ? 'bg-surface-dark border-slate-700' : 'bg-surface border-slate-200'}`}>
              <h3 className={`text-xl font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-4`}>Professionals/Supervisors</h3>
              <ul className={`space-y-2 ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>
                <li>• Validate requirement quality</li>
                <li>• Oversee requirement processes</li>
                <li>• Ensure consistency across teams</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* Technology Snapshot */}
      <section
        id="tech"
        className={`py-16 ${darkMode ? 'bg-background-dark' : 'bg-surface'}`}
        style={{ opacity: isVisible.tech ? 1 : 0, transform: isVisible.tech ? 'translateY(0)' : 'translateY(20px)' }}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 className={`text-2xl font-bold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-8`}>Built with Modern Technology</h2>
          <div className="flex flex-wrap justify-center gap-4">
