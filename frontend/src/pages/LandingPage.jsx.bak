          <div className="grid md:grid-cols-3 gap-8">
            <div className={`text-center p-6 ${darkMode ? 'bg-surface-dark border border-slate-700' : 'bg-surface'} rounded-xl shadow-sm hover:shadow-md transition-shadow`}>
              <div className={`${darkMode ? 'bg-slate-700' : 'bg-blue-100'} w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4`}>
                <FileText className={`h-8 w-8 ${darkMode ? 'text-primary/80' : 'text-primary'}`} />
              </div>
              <h3 className={`text-xl font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-2`}>Upload Document</h3>
              <p className={`${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>Submit your requirements document in PDF, DOCX, or plain text format</p>
            </div>

            <div className={`text-center p-6 ${darkMode ? 'bg-surface-dark border border-slate-700' : 'bg-surface'} rounded-xl shadow-sm hover:shadow-md transition-shadow`}>
              <div className={`${darkMode ? 'bg-emerald-900/30' : 'bg-green-100'} w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4`}>
                <Brain className={`h-8 w-8 ${darkMode ? 'text-success/80' : 'text-success'}`} />
              </div>
              <h3 className={`text-xl font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-2`}>AI Validation</h3>
              <p className={`${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>Our AI analyzes the document for ambiguities and inconsistencies</p>
            </div>

            <div className={`text-center p-6 ${darkMode ? 'bg-surface-dark border border-slate-700' : 'bg-surface'} rounded-xl shadow-sm hover:shadow-md transition-shadow`}>
              <div className={`${darkMode ? 'bg-amber-900/30' : 'bg-amber-100'} w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4`}>
                <BarChart3 className={`h-8 w-8 ${darkMode ? 'text-warning/80' : 'text-warning'}`} />
              </div>
              <h3 className={`text-xl font-semibold ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-2`}>Effort Estimation</h3>
              <p className={`${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'}`}>Get detailed reports with complexity metrics and risk analysis</p>
            </div>
          </div>
        </div>
      </section>

      {/* Product Preview */}
      <section
        id="preview"
        className={`py-16 ${darkMode ? 'bg-background-dark' : 'bg-surface'}`}
        style={{ opacity: isVisible.preview ? 1 : 0, transform: isVisible.preview ? 'translateY(0)' : 'translateY(20px)' }}
      >
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 className={`text-3xl font-bold text-center ${darkMode ? 'text-text-primary-dark' : 'text-text-primary'} mb-4`}>Product Preview</h2>
          <p className={`text-center ${darkMode ? 'text-text-secondary-dark' : 'text-text-secondary'} mb-12 max-w-2xl mx-auto`}>
            Instantly validate and visualize your software requirements
