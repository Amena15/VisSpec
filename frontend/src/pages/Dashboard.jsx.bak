            </Link>
          </div>
        </div>

        {/* Cost & Complexity Prediction Modal */}
        {showCostPrediction && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
            <div className="bg-[var(--card-bg)] rounded-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto modal">
              <div className="p-6 border-b border-[var(--card-border)] flex items-center justify-between">
                <h2 className="text-xl font-semibold text-[var(--neutral-900)]">Cost & Complexity Prediction</h2>
                <button
                  onClick={() => setShowCostPrediction(false)}
                  className="text-[var(--neutral-500)] hover:text-[var(--neutral-900)] text-2xl"
                >
                  &times;
                </button>
              </div>
              <div className="p-6">
                <CostComplexityPrediction
                  requirements={[/* mock requirements data */]}
                  analysisResults={{ defects: 5 }}
                />
              </div>
            </div>
          </div>
        )}

        {/* Export Report Modal */}
        {showExportModal && (
          <ExportReport
            documentData={{ requirements: [] }}
            analysisResults={{ defects: [] }}
            onClose={() => setShowExportModal(false)}
          />
        )}

        {/* KPI Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          {kpiCards.map((card) => (
            <div
              key={card.id}
              className="bg-[var(--card-bg)] shadow-sm rounded-xl p-6 border border-[var(--card-border)] hover:shadow-md transition-shadow"
            >
              <div className="flex items-center justify-between mb-4">
                <div className={`${card.iconBg} rounded-full p-3`}>
                  <card.icon className={`h-6 w-6 ${card.iconColor}`} />
                </div>
                {card.trend && (
                  <span className={`text-sm font-medium flex items-center ${
                    card.trendPositive ? 'text-[var(--success-main)]' : 'text-[var(--error-main)]'
                  }`}>
                    {card.trendPositive ? <TrendingUp className="h-4 w-4 mr-1" /> : <TrendingUp className="h-4 w-4 mr-1 transform rotate-180" />}
                    {card.trend}
                  </span>
                )}
              </div>
              <h3 className="text-lg font-medium text-[var(--neutral-600)] mb-1">{card.title}</h3>
              <div className="flex items-baseline">
                <span className="text-2xl font-bold text-[var(--neutral-900)]">{card.value}</span>
              </div>
              {card.progress && (
                <div className="mt-3 w-full bg-[var(--neutral-200)] rounded-full h-2">
                  <div
                    className="bg-[var(--success-main)] h-2 rounded-full"
                    style={{ width: `${card.progress}%` }}
                  ></div>
                </div>
              )}
              {card.subtext && (
                <p className={`text-sm mt-2 ${
                  card.title.includes('Defects') || card.title.includes('Issues') ? 'text-[var(--warning-main)]' : 'text-[var(--success-main)]'
                }`}>
                  {card.subtext}
                </p>
              )}
            </div>
          ))}
        </div>

        {/* Recent Reports Section */}
        <div className="bg-[var(--card-bg)] rounded-xl shadow-sm border border-[var(--card-border)] overflow-hidden">
          <div className="p-6 border-b border-[var(--card-border)]">
            <h2 className="text-xl font-semibold text-[var(--neutral-900)]">Recent Reports</h2>
            <p className="text-[var(--neutral-600)] mt-1">Latest analysis results and validation reports</p>
          </div>

          <div className="divide-y divide-[var(--card-border)]">
            {recentReports.map((report) => (
              <div key={report.id} className="p-6 hover:bg-[var(--card-bg)] transition-colors">
                <div className="flex items-center justify-between">
                  <div className="flex items-center space-x-4">
                    <div className="bg-[var(--neutral-100)] p-2 rounded-lg">
                      <FileText className="h-5 w-5 text-[var(--accent-main)]" />
                    </div>
                    <div>
                      <h3 className="font-medium text-[var(--neutral-900)]">{report.title}</h3>
                      <div className="flex items-center space-x-4 mt-1">
                        <span className="text-sm text-[var(--neutral-600)] flex items-center">
                          <Clock className="h-4 w-4 mr-1" />
                          {report.date}
                        </span>
                        <span className="text-xs px-2 py-1 bg-[var(--card-bg)] text-[var(--neutral-600)] rounded-full">
                          {report.type}
                        </span>
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center space-x-6">
                    <div className="flex items-center space-x-4">
                      <div className="text-center">
                        <p className="text-sm font-medium text-[var(--neutral-900)]">{report.quality}</p>
                        <p className="text-xs text-[var(--neutral-600)]">Quality</p>
                      </div>
                      <div className="text-center">
                        <span className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                          report.issues > 5 ? 'bg-[var(--error-light)] text-[var(--error-main)]' :
                          report.issues > 0 ? 'bg-[var(--warning-light)] text-[var(--warning-main)]' : 'bg-[var(--success-light)] text-[var(--success-main)]'
                        }`}>
                          {report.issues > 0 ? <AlertTriangle className="h-3 w-3 mr-1" /> : <Check className="h-3 w-3 mr-1" />}
                          {report.issues} issues
                        </span>
                        <p className="text-xs text-[var(--neutral-600)] mt-1">Defects</p>
                      </div>
                    </div>

                    <Link
                      to={`/analysis/${report.id}`}
                      className="px-4 py-2 border border-[var(--card-border)] text-[var(--accent-main)] rounded-lg hover:bg-[var(--card-bg)] transition-colors"
                    >
                      View Report
                    </Link>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

export default Dashboard;