import React, { useState, useEffect } from 'react';
import {
  FolderOpen,
  BarChart3,
  AlertCircle,
  CheckCircle,
  FileText,
  Filter,
  Plus,
  TrendingUp,
  Clock,
  AlertTriangle,
  Check,
  Download,
  Eye,
  Users,
  Share
} from 'lucide-react';
import { Link, useNavigate } from 'react-router-dom';
import ExportReport from '../components/ExportReport';
import CostComplexityPrediction from '../components/CostComplexityPrediction';

const Dashboard = () => {
  // Mock data for KPI cards
  const kpiCards = [
    {
      id: 1,
      title: 'Est. Effort',
      value: '12 Weeks',
      trend: '+2 this week',
      trendPositive: true,
      icon: Clock,
      iconBg: 'bg-[var(--neutral-100)]',
      iconColor: 'text-[var(--metric-effort-icon)]'
    },
    {
      id: 2,
      title: 'Avg. Quality Score',
      value: '85%',
      progress: 85,
      icon: BarChart3,
      iconBg: 'bg-[var(--neutral-100)]',
      iconColor: 'text-[var(--metric-quality-icon)]'
    },
    {
      id: 3,
      title: 'Active Defects',
      value: '24',
      subtext: 'Requires Attention',
      icon: AlertCircle,
      iconBg: 'bg-[var(--neutral-100)]',
      iconColor: 'text-[var(--metric-defects-icon)]'
    },
    {
      id: 4,
      title: 'Validation Rate',
      value: '92%',
      subtext: 'IEEE 830 Compliant',
      icon: CheckCircle,
      iconBg: 'bg-[var(--neutral-100)]',
      iconColor: 'text-[var(--metric-validation-icon)]'
    }
  ];

  // Mock data for recent reports
  const recentReports = [
    {
      id: 1,
      title: 'Student Registration System',
      date: 'Oct 24, 2025',
      type: 'SRS',
      quality: '88%',
      issues: 3,
      status: 'completed'
    },
    {
      id: 2,
      title: 'E-Commerce Platform Requirements',
      date: 'Oct 23, 2025',
      type: 'SRS',
      quality: '76%',
      issues: 8,
      status: 'completed'
    },
    {
      id: 3,
      title: 'Healthcare Management System',
      date: 'Oct 22, 2025',
      type: 'SRS',
      quality: '92%',
      issues: 1,
      status: 'completed'
    },
    {
      id: 4,
      title: 'Financial Reporting Tool',
      date: 'Oct 21, 2025',
      type: 'SRS',
      quality: '65%',
      issues: 12,
      status: 'in-progress'
    },
    {
      id: 5,
      title: 'Library Management System',
      date: 'Oct 20, 2025',
      type: 'SRS',
      quality: '95%',
      issues: 0,
      status: 'completed'
    }
  ];

  const [showExportModal, setShowExportModal] = useState(false);
  const [showCostPrediction, setShowCostPrediction] = useState(false);

  const handleExportReport = () => {
    setShowExportModal(true);
  };

  return (
    <div className="min-h-screen bg-[var(--content-bg)]">
      <div className="p-8">
        {/* Header */}
        <div className="flex items-center justify-between mb-8">
          <div>
            <h1 className="text-3xl font-bold text-[var(--neutral-900)]">Analysis Overview</h1>
            <p className="text-[var(--neutral-600)] mt-2">
              Track requirement quality and validation trends across all projects
            </p>
          </div>
          <div className="flex items-center space-x-3">
            <button
