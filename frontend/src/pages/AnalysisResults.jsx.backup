import React, { useState, useEffect } from 'react';
import {
  ArrowLeft,
  FileText,
  AlertTriangle,
  CheckCircle,
  Clock,
  Eye,
  Download,
  AlertCircle,
  ArrowRight,
  Undo2,
  RotateCcw,
  AlertOctagon,
  X
} from 'lucide-react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import ExportReport from '../components/ExportReport';
import TraceabilityMatrix from '../components/TraceabilityMatrix';

const AnalysisResults = () => {
  const { documentId } = useParams();
  const navigate = useNavigate();
  const [activeTab, setActiveTab] = useState('findings');
  const [selectedFinding, setSelectedFinding] = useState(null);
  const [showExportModal, setShowExportModal] = useState(false);
  const [requirements, setRequirements] = useState([]);
  const [findings, setFindings] = useState([]);
  const [originalRequirements, setOriginalRequirements] = useState([]);
  const [history, setHistory] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [successMessage, setSuccessMessage] = useState('');

  // Mock data initialization
  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true);
        setError(null);
        
        // Simulate API call delay
        await new Promise(resolve => setTimeout(resolve, 800));
        
        // In a real app, this would fetch from the backend
        const mockRequirements = [
          {
            id: 1,
            text: "The system shall allow users to register with a unique username and password.",
            category: "functional",
            status: "valid",
            originalText: "The system shall allow users to register with a unique username and password."
          },
          {
            id: 2,
            text: "The system shall authenticate users using their credentials.",
            category: "functional",
            status: "valid",
            originalText: "The system shall authenticate users using their credentials."
          },
          {
            id: 3,
            text: "The system shall provide secure access to user data.",
            category: "security",
            status: "ambiguous",
            findingId: 1,
            originalText: "The system shall provide secure access to user data."
          },
          {
            id: 4,
            text: "The system shall respond to user requests within 2 seconds.",
            category: "performance",
            status: "ambiguous",
            findingId: 2,
            originalText: "The system shall respond to user requests within 2 seconds."
          },
          {
            id: 5,
            text: "The system shall store user information in a database.",
            category: "data",
            status: "valid",
            originalText: "The system shall store user information in a database."
          },
          {
            id: 6,
            text: "The system shall send notifications to users when their account is locked.",
            category: "notification",
            status: "conflict",
            findingId: 3,
            originalText: "The system shall send notifications to users when their account is locked."
          },
          {
            id: 7,
            text: "The system shall lock accounts after 3 failed login attempts.",
            category: "security",
            status: "conflict",
            findingId: 3,
            originalText: "The system shall lock accounts after 3 failed login attempts."
          }
        ];

        const mockFindings = [
          {
            id: 1,
            type: 'ambiguity',
            title: 'Ambiguous Term: "Secure"',
            description: 'The term "secure" in requirement 3 is ambiguous and lacks specific security standards.',
            suggestion: 'Define specific security standards (e.g., encryption protocols, password complexity)',
            requirementId: 'REQ-003',
            severity: 'high',
            confidence: 0.85
          },
          {
            id: 2,
            type: 'ambiguity',
            title: 'Vague Performance Requirement',
            description: 'The performance requirement in requirement 4 uses "within 2 seconds" without specifying conditions.',
            suggestion: 'Specify under what conditions the 2-second response time applies',
            requirementId: 'REQ-004',
            severity: 'medium',
            confidence: 0.78
          },
          {
            id: 3,
            type: 'conflict',
            title: 'Contradictory Requirements',
            description: 'Requirement 6 mentions notifications for account lock, but requirement 7 doesn\'t specify notification for lockout.',
            suggestion: 'Clarify if notifications should be sent for all account lockouts',
            requirementId: 'REQ-006',
            severity: 'high',
            confidence: 0.92
          }
        ];

        setRequirements(mockRequirements);
        setFindings(mockFindings);
        setOriginalRequirements([...mockRequirements]); // Store original for undo functionality
      } catch (err) {
        setError('Failed to load analysis results. Please try again later.');
        console.error('Error loading analysis results:', err);
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, [documentId]);

  // Apply suggestion to a requirement
  const applySuggestion = (findingId) => {
    const finding = findings.find(f => f.id === findingId);
    if (!finding) return;

    // Save current state to history for undo functionality (BR-15)
    setHistory(prev => [...prev, [...requirements]]);

    setRequirements(prev => prev.map(req => {
      if (req.findingId === findingId) {
        // Apply the suggestion by modifying the text
        let newText = req.originalText;
        
        // Simple text replacement based on the suggestion
        if (finding.suggestion.includes('encryption protocols')) {
          newText = newText.replace('secure', 'encrypted using AES-256');
        } else if (finding.suggestion.includes('specify under what conditions')) {
          newText = newText.replace('within 2 seconds', 'within 2 seconds under normal load conditions');
        } else if (finding.suggestion.includes('clarify if notifications')) {
          newText = newText + ' All account lockouts must trigger a notification.';
        }

        return {
          ...req,
          text: newText,
          status: 'valid', // Mark as valid after applying suggestion
          originalText: req.originalText
        };
      }
      return req;
    }));

    // Trigger auto re-validation after applying fix (BR-14)
    setTimeout(() => {
      console.log('Auto re-validation triggered after applying fix');
    }, 1000);
  };

  // Dismiss a finding (mark as reviewed but don't apply suggestion)
  const dismissFinding = (findingId) => {
    setRequirements(prev => prev.map(req => {
      if (req.findingId === findingId) {
        return {
          ...req,
          status: 'dismissed' // Mark as dismissed
        };
      }
      return req;
    }));
  };

  // Undo the last action (BR-15)
  const undoAction = () => {
    if (history.length > 0) {
      const prevState = history[history.length - 1];
      setRequirements([...prevState]);
      setHistory(prev => prev.slice(0, -1)); // Remove the last state from history
    }
  };

  // Get severity color
  const getSeverityColor = (severity) => {
    switch(severity) {
      case 'high': return 'border-l-red-500 bg-red-50';
      case 'medium': return 'border-l-amber-500 bg-amber-50';
      case 'low': return 'border-l-blue-500 bg-blue-50';
      default: return 'border-l-gray-300 bg-gray-50';
    }
  };

  // Document info
  const documentInfo = {
    name: 'Sample_SRS_Document.pdf',
    size: '2.4 MB',
    uploaded: '2023-11-15',
    status: 'analyzed',
    qualityScore: 78,
    defectCount: 3,
    estimatedEffort: '12 weeks'
  };

  return (
    <>
    <div className="min-h-screen bg-[var(--neutral-50)]">
      <div className="py-6">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          {/* Success Message */}
          {successMessage && (
            <div className="mb-4 p-4 bg-[var(--success-light)] border border-[var(--success-main)] text-[var(--success-dark)] rounded-lg flex items-center">
              <CheckCircle className="h-5 w-5 mr-2" />
              <span>{successMessage}</span>
            </div>
          )}
          
          {/* Error Message */}
          {error && (
            <div className="mb-4 p-4 bg-[var(--error-light)] border border-[var(--error-main)] text-[var(--error-dark)] rounded-lg flex items-center">
              <AlertCircle className="h-5 w-5 mr-2" />
              <span>{error}</span>
            </div>
          )}
          
          {/* Loading State */}
          {loading && (
            <div className="space-y-6">
              {/* Header Skeleton */}
              <div className="flex items-center justify-between mb-6">
                <div className="flex items-center">
                  <div className="bg-[var(--neutral-200)] animate-pulse rounded w-6 h-6 mr-4"></div>
                  <div>
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-48 h-6 mb-2"></div>
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-4"></div>
                  </div>
                </div>
                <div className="flex items-center space-x-3">
                  <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-10"></div>
                  <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-10"></div>
                </div>
              </div>

              {/* Document Info Card Skeleton */}
              <div className="bg-[var(--card-bg)] rounded-xl shadow-sm p-6 mb-6">
                <div className="flex items-center justify-between">
                  <div className="flex items-center">
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-12 h-12 mr-4"></div>
                    <div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-40 h-5 mb-2"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-4"></div>
                    </div>
                  </div>
                  <div className="flex items-center space-x-6">
                    <div className="text-center">
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-16 h-6 mb-1"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-20 h-3"></div>
                    </div>
                    <div className="text-center">
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-16 h-6 mb-1"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-20 h-3"></div>
                    </div>
                    <div className="text-center">
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-16 h-6 mb-1"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-20 h-3"></div>
                    </div>
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-6"></div>
                  </div>
                </div>
              </div>

              {/* Tabs Skeleton */}
              <div className="bg-[var(--card-bg)] rounded-xl shadow-sm overflow-hidden">
                <div className="border-b border-[var(--card-border)]">
                  <div className="flex space-x-8 px-6 py-4">
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-6"></div>
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-6"></div>
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-6"></div>
                  </div>
                </div>

                <div className="p-6">
                  {/* Content Skeleton */}
                  <div className="space-y-4">
                    <div className="flex justify-between items-center">
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-40 h-6"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-8"></div>
                    </div>
                    
                    <div className="space-y-3">
                      {[...Array(3)].map((_, i) => (
                        <div key={i} className="border-l-4 bg-[var(--card-bg)] shadow-sm rounded-r-lg p-4 animate-pulse">
                          <div className="flex justify-between items-start">
                            <div className="flex items-start">
                              <div className="mr-4 mt-1">
                                <div className="bg-[var(--neutral-200)] rounded-full w-5 h-5"></div>
                              </div>
                              <div>
                                <div className="flex items-center space-x-2 mb-2">
                                  <div className="bg-[var(--neutral-200)] rounded-full w-24 h-6"></div>
                                  <div className="bg-[var(--neutral-200)] rounded w-16 h-4"></div>
                                  <div className="bg-[var(--neutral-200)] rounded w-24 h-4"></div>
                                </div>
                                <div className="bg-[var(--neutral-200)] rounded w-64 h-5 mb-2"></div>
                                <div className="bg-[var(--neutral-200)] rounded w-96 h-4 mb-2"></div>
                                <div className="bg-[var(--neutral-200)] rounded w-80 h-4"></div>
                              </div>
                            </div>
                            <div className="bg-[var(--neutral-200)] rounded w-6 h-6"></div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
          
          {/* Content Area */}
          <div className="space-y-6">
            {/* Conditionally render content based on loading/error state */}
            {loading && (
              <div className="space-y-6">
                {/* Header Skeleton */}
                <div className="flex items-center justify-between mb-6">
                  <div className="flex items-center">
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-6 h-6 mr-4"></div>
                    <div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-48 h-6 mb-2"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-4"></div>
                    </div>
                  </div>
                  <div className="flex items-center space-x-3">
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-10"></div>
                    <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-10"></div>
                  </div>
                </div>

                {/* Document Info Card Skeleton */}
                <div className="bg-[var(--card-bg)] rounded-xl shadow-sm p-6 mb-6">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center">
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-12 h-12 mr-4"></div>
                      <div>
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-40 h-5 mb-2"></div>
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-4"></div>
                      </div>
                    </div>
                    <div className="flex items-center space-x-6">
                      <div className="text-center">
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-16 h-6 mb-1"></div>
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-20 h-3"></div>
                      </div>
                      <div className="text-center">
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-16 h-6 mb-1"></div>
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-20 h-3"></div>
                      </div>
                      <div className="text-center">
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-16 h-6 mb-1"></div>
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-20 h-3"></div>
                      </div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-6"></div>
                    </div>
                  </div>
                </div>

                {/* Tabs Skeleton */}
                <div className="bg-[var(--card-bg)] rounded-xl shadow-sm overflow-hidden">
                  <div className="border-b border-[var(--card-border)]">
                    <div className="flex space-x-8 px-6 py-4">
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-6"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-6"></div>
                      <div className="bg-[var(--neutral-200)] animate-pulse rounded w-24 h-6"></div>
                    </div>
                  </div>

                  <div className="p-6">
                    {/* Content Skeleton */}
                    <div className="space-y-4">
                      <div className="flex justify-between items-center">
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-40 h-6"></div>
                        <div className="bg-[var(--neutral-200)] animate-pulse rounded w-32 h-8"></div>
                      </div>
                      
                      <div className="space-y-3">
                        {[...Array(3)].map((_, i) => (
                          <div key={i} className="border-l-4 bg-[var(--card-bg)] shadow-sm rounded-r-lg p-4 animate-pulse">
                            <div className="flex justify-between items-start">
                              <div className="flex items-start">
                                <div className="mr-4 mt-1">
                                  <div className="bg-[var(--neutral-200)] rounded-full w-5 h-5"></div>
                                </div>
                                <div>
                                  <div className="flex items-center space-x-2 mb-2">
                                    <div className="bg-[var(--neutral-200)] rounded-full w-24 h-6"></div>
                                    <div className="bg-[var(--neutral-200)] rounded w-16 h-4"></div>
                                    <div className="bg-[var(--neutral-200)] rounded w-24 h-4"></div>
                                  </div>
                                  <div className="bg-[var(--neutral-200)] rounded w-64 h-5 mb-2"></div>
                                  <div className="bg-[var(--neutral-200)] rounded w-96 h-4 mb-2"></div>
                                  <div className="bg-[var(--neutral-200)] rounded w-80 h-4"></div>
                                </div>
                              </div>
                              <div className="bg-[var(--neutral-200)] rounded w-6 h-6"></div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
            
            {!loading && !error && (
              <div>
              {/* Header */}
              <div className="flex items-center justify-between mb-6">
            <div className="flex items-center">
              <Link to="/analysis" className="text-[var(--primary-main)] hover:text-[var(--primary-dark)] mr-4">
                <ArrowLeft className="h-5 w-5" />
              </Link>
              <div>
                <h1 className="text-2xl font-bold text-[var(--neutral-900)]">Analysis Results</h1>
                <p className="text-[var(--neutral-600)]">{documentInfo.name} • {documentInfo.size}</p>
              </div>
            </div>
            <div className="flex items-center space-x-3">
              <button 
                onClick={() => setShowExportModal(true)}
                className="flex items-center px-4 py-2 bg-[var(--card-bg)] border border-[var(--card-border)] rounded-lg text-[var(--primary-main)] hover:bg-[var(--neutral-50)] transition-colors"
              >
                <Download className="h-4 w-4 mr-2" />
                Export Report
              </button>
              <Link
                to="/visualization"
                className="flex items-center px-4 py-2 bg-[var(--primary-main)] text-white rounded-lg hover:bg-[var(--primary-dark)] transition-colors"
              >
                Visualize
                <ArrowRight className="ml-2 h-4 w-4" />
              </Link>
            </div>
          </div>

          {/* Document Info Card */}
          <div className="bg-[var(--card-bg)] rounded-xl shadow-sm p-6 mb-6">
            <div className="flex items-center justify-between">
              <div className="flex items-center">
                <div className="bg-[var(--primary-50)] p-3 rounded-lg mr-4">
                  <FileText className="h-6 w-6 text-[var(--primary-main)]" />
                </div>
                <div>
                  <h2 className="text-lg font-semibold text-[var(--neutral-900)]">{documentInfo.name}</h2>
                  <p className="text-sm text-[var(--neutral-600)]">Uploaded: {new Date(documentInfo.uploaded).toLocaleDateString()}</p>
                </div>
              </div>
              <div className="flex items-center space-x-6">
                <div className="text-center">
                  <div className="text-2xl font-bold text-[var(--neutral-900)]">{documentInfo.qualityScore}%</div>
                  <div className="text-xs text-[var(--neutral-600)]">Quality Score</div>
                </div>
                <div className="text-center">
                  <div className="text-2xl font-bold text-[var(--neutral-900)]">{documentInfo.defectCount}</div>
                  <div className="text-xs text-[var(--neutral-600)]">Defects Found</div>
                </div>
                <div className="text-center">
                  <div className="text-2xl font-bold text-[var(--neutral-900)]">{documentInfo.estimatedEffort}</div>
                  <div className="text-xs text-[var(--neutral-600)]">Est. Effort</div>
                </div>
                <span className={
                  documentInfo.status === 'analyzed' ? 'px-3 py-1 rounded-full text-xs font-medium bg-[var(--success-light)] text-[var(--success-dark)]' :
                  documentInfo.status === 'pending' ? 'px-3 py-1 rounded-full text-xs font-medium bg-[var(--warning-light)] text-[var(--warning-dark)]' :
                  'px-3 py-1 rounded-full text-xs font-medium bg-[var(--info-light)] text-[var(--info-dark)]'
                }>
                  {documentInfo.status.charAt(0).toUpperCase() + documentInfo.status.slice(1)}
                </span>
              </div>
            </div>
          </div>

          {/* Tabs */}
          <div className="bg-[var(--card-bg)] rounded-xl shadow-sm overflow-hidden">
            <div className="border-b border-[var(--card-border)]">
              <nav role="tablist" className="flex space-x-8 px-6">
                <button
                  id="findings-tab"
                  role="tab"
                  aria-selected={activeTab === 'findings'}
                  aria-controls="findings-panel"
                  onClick={() => setActiveTab('findings')}
                  className={
                    activeTab === 'findings'
                      ? 'py-4 px-1 border-b-2 font-medium text-sm border-[var(--primary-main)] text-[var(--primary-main)]'
                      : 'py-4 px-1 border-b-2 font-medium text-sm border-transparent text-[var(--neutral-600)] hover:text-[var(--primary-main)] hover:border-[var(--neutral-300)]'
                  }
                >
                  Analysis Findings
                </button>
                <button
                  id="requirements-tab"
                  role="tab"
                  aria-selected={activeTab === 'requirements'}
                  aria-controls="requirements-panel"
                  onClick={() => setActiveTab('requirements')}
                  className={
                    activeTab === 'requirements'
                      ? 'py-4 px-1 border-b-2 font-medium text-sm border-[var(--primary-main)] text-[var(--primary-main)]'
                      : 'py-4 px-1 border-b-2 font-medium text-sm border-transparent text-[var(--neutral-600)] hover:text-[var(--primary-main)] hover:border-[var(--neutral-300)]'
                  }
                >
                  Requirements
                </button>
                <button
                  id="traceability-tab"
                  role="tab"
                  aria-selected={activeTab === 'traceability'}
                  aria-controls="traceability-panel"
                  onClick={() => setActiveTab('traceability')}
                  className={
                    activeTab === 'traceability'
                      ? 'py-4 px-1 border-b-2 font-medium text-sm border-[var(--primary-main)] text-[var(--primary-main)]'
                      : 'py-4 px-1 border-b-2 font-medium text-sm border-transparent text-[var(--neutral-600)] hover:text-[var(--primary-main)] hover:border-[var(--neutral-300)]'
                  }
                >
                  Traceability
                </button>
              </nav>
            </div>

            <div className="p-6">
              {/* Findings Tab */}
              {activeTab === 'findings' && (
                <div id="findings-panel" role="tabpanel" aria-labelledby="findings-tab" className="space-y-4">
                  <div className="flex justify-between items-center mb-4">
                    <h3 className="text-lg font-medium text-[var(--neutral-900)]">Detected Issues</h3>
                    {history.length > 0 && (
                      <button
                        onClick={undoAction}
                        className="flex items-center text-sm text-[var(--primary-main)] hover:text-[var(--primary-dark)]"
                      >
                        <Undo2 className="h-4 w-4 mr-1" />
                        Undo Last Change
                      </button>
                    )}
                  </div>
                  
                  {findings.map((finding) => (
                    <div
                      key={finding.id}
                      className={
                        'border-l-4 ' + getSeverityColor(finding.severity).split(' ')[0] + ' bg-white shadow-sm rounded-r-lg p-4 hover:shadow-md transition-shadow cursor-pointer ' +
                        (selectedFinding === finding.id ? 'ring-2 ring-[#4F6D7A] ring-opacity-50' : '')
                      }
                      onClick={() => setSelectedFinding(selectedFinding === finding.id ? null : finding.id)}
                    >
                      <div className="flex justify-between items-start">
                        <div className="flex items-start">
                          <div className="mr-4 mt-1">
                            {finding.type === 'ambiguity' ? (
                              <AlertTriangle className="h-5 w-5 text-amber-600" />
                            ) : (
                              <AlertTriangle className="h-5 w-5 text-red-600" />
                            )}
                          </div>
                          <div>
                            <div className="flex items-center space-x-2 mb-1">
                              <span className={
                                finding.type === 'ambiguity'
                                  ? 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800'
                                  : 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800'
                              }>
                                {finding.type === 'ambiguity' ? <AlertTriangle className="h-3 w-3 mr-1" /> : <AlertOctagon className="h-3 w-3 mr-1" />}
                                {finding.type.charAt(0).toUpperCase() + finding.type.slice(1)}
                              </span>
                              <span className="text-xs text-[#6B7280]">{finding.requirementId}</span>
                              <span className="text-xs text-[#6B7280]">Confidence: {(finding.confidence * 100).toFixed(0)}%</span>
                            </div>
                            <h4 className="text-lg font-medium text-[#1F2933]">{finding.title}</h4>
                            <p className="text-[#6B7280] mt-2">{finding.description}</p>
                            <div className="mt-3 p-3 bg-[#F9FAFB] rounded border border-[#E5E7EB]">
                              <p className="text-sm font-medium text-[#4F6D7A]">Suggested Fix:</p>
                              <p className="text-sm text-[#6B7280] mt-1">{finding.suggestion}</p>
                              <div className="mt-3 flex space-x-2">
                                <button 
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    applySuggestion(finding.id);
                                  }}
                                  className="text-xs bg-[#4F6D7A] text-white px-3 py-1 rounded hover:bg-[#4338CA] transition-colors flex items-center"
                                >
                                  <CheckCircle className="h-3 w-3 mr-1" />
                                  Apply Suggestion
                                </button>
                                <button 
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    dismissFinding(finding.id);
                                  }}
                                  className="text-xs border border-[#E5E7EB] text-[#4F6D7A] px-3 py-1 rounded hover:bg-[#F9FAFB] transition-colors"
                                >
                                  Dismiss
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                        <button className="text-[#4F6D7A] hover:text-[#4338CA]">
                          <Eye className="h-5 w-5" />
                        </button>
                      </div>

                      {selectedFinding === finding.id && (
                        <div className="mt-4 pt-4 border-t border-[#E5E7EB]">
                          <h5 className="font-medium text-[#1F2933] mb-2">Related Requirements:</h5>
                          <div className="space-y-2">
                            {requirements.filter(req => req.findingId === finding.id).map(req => (
                              <div key={req.id} className="bg-[#F9FAFB] p-3 rounded border border-[#E5E7EB]">
                                <div className="flex justify-between">
                                  <span className="font-medium">Requirement {req.id}</span>
                                  <span className={
                                    req.status === 'ambiguous' ? 'text-xs px-2 py-1 rounded-full bg-amber-100 text-amber-800' :
                                    req.status === 'conflict' ? 'text-xs px-2 py-1 rounded-full bg-red-100 text-red-800' :
                                    req.status === 'valid' ? 'text-xs px-2 py-1 rounded-full bg-green-100 text-green-800' :
                                    'text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-800'
                                  }>
                                    {req.status}
                                  </span>
                                </div>
                                <p className="text-sm text-[#6B7280] mt-1">{req.text}</p>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {/* Requirements Tab */}
              {activeTab === 'requirements' && (
                <div id="requirements-panel" role="tabpanel" aria-labelledby="requirements-tab" className="space-y-4">
                  <h3 className="text-lg font-medium text-[var(--neutral-900)] mb-4">Requirements Analysis</h3>
                  {requirements.map((req) => (
                    <div
                      key={req.id}
                      className={
                        `bg-[var(--card-bg)] border border-[var(--card-border)] rounded-lg p-4 hover:shadow-md transition-shadow ` +
                        (req.status !== 'valid' && req.status !== 'dismissed' ? 'border-l-4 border-l-[var(--error-main)]' : '')
                      }
                    >
                      <div className="flex justify-between items-start">
                        <div>
                          <div className="flex items-center space-x-2 mb-2">
                            <span className="text-sm font-medium text-[var(--neutral-900)]">REQ-{req.id.toString().padStart(3, '0')}</span>
                            <span className={
                              req.status === 'ambiguous' ? 'text-xs px-2 py-1 rounded-full bg-[var(--warning-light)] text-[var(--warning-dark)]' :
                              req.status === 'conflict' ? 'text-xs px-2 py-1 rounded-full bg-[var(--error-light)] text-[var(--error-dark)]' :
                              req.status === 'valid' ? 'text-xs px-2 py-1 rounded-full bg-[var(--success-light)] text-[var(--success-dark)]' :
                              'text-xs px-2 py-1 rounded-full bg-[var(--neutral-100)] text-[var(--neutral-800)]'
                            }>
                              {req.status}
                            </span>
                            <span className="text-xs text-[var(--neutral-600)] bg-[var(--neutral-50)] px-2 py-1 rounded">
                              {req.category}
                            </span>
                          </div>
                          <p className="text-[var(--neutral-900)]">{req.text}</p>
                          
                          {/* Show original text if modified */}
                          {req.text !== req.originalText && (
                            <div className="mt-2 p-2 bg-[var(--info-light)] rounded border border-[var(--info-main)]">
                              <p className="text-xs text-[var(--info-main)]">Original: {req.originalText}</p>
                            </div>
                          )}
                        </div>
                        {req.status !== 'valid' && req.status !== 'dismissed' && (
                          <div className="flex space-x-2">
                            <button 
                              onClick={() => {
                                const finding = findings.find(f => f.id === req.findingId);
                                if (finding) applySuggestion(finding.id);
                              }}
                              className="text-[var(--primary-main)] hover:text-[var(--primary-dark)]"
                            >
                              <CheckCircle className="h-5 w-5" />
                            </button>
                            <button 
                              onClick={() => {
                                const finding = findings.find(f => f.id === req.findingId);
                                if (finding) dismissFinding(finding.id);
                              }}
                              className="text-[var(--error-main)] hover:text-[var(--error-dark)]"
                            >
                              <X className="h-5 w-5" />
                            </button>
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {/* Traceability Tab */}
              {activeTab === 'traceability' && (
                <div id="traceability-panel" role="tabpanel" aria-labelledby="traceability-tab">
                  <h3 className="text-lg font-medium text-[var(--neutral-900)] mb-4">Requirements Traceability</h3>
                  <TraceabilityMatrix 
                    requirements={requirements} 
                    defects={findings} 
                    onAddNote={(reqId, note) => console.log('Added note to ' + reqId + ': ' + note)} 
                  />
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
    
    {/* Export Report Modal - Positioned as overlay */}
    {showExportModal && (
      <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <ExportReport
          documentData={{ requirements }}
          analysisResults={{ defects: findings, qualityScore: documentInfo.qualityScore }}
          onClose={() => setShowExportModal(false)}
        />
      </div>
    )}

    {/* Business Rules Notice */}
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 mb-8">
      <div className="bg-[var(--info-light)] border border-[var(--info-main)] rounded-lg p-4">
        <div className="flex items-start">
          <FileText className="w-5 h-5 text-[var(--info-main)] mt-0.5 mr-2 flex-shrink-0" />
          <div>
            <h4 className="font-medium text-[var(--info-dark)] text-sm">Business Rules Compliance</h4>
            <ul className="text-xs text-[var(--info-dark)] mt-1 space-y-1">
              <li>• Auto re-validation triggered after applying fixes (BR-14)</li>
              <li>• Undo functionality available for applied changes (BR-15)</li>
              <li>• Only defects with {'>'}70% confidence shown (BR-10)</li>
              <li>• All exported reports include VisSpec watermark (BR-20)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </>
  );
};

export default AnalysisResults;