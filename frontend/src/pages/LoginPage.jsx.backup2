import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import axios from 'axios';
import { recordFailedAttempt, isLockedOut, getRemainingLockoutTime, getFailedAttempts, clearLoginAttempts } from '../utils/authUtils';

// Constants for authentication
const MAX_FAILED_ATTEMPTS = 5;
const LOCKOUT_DURATION = 15; // in minutes

const LoginPage = ({ onLogin }) => {
  const [isLogin, setIsLogin] = useState(true);
  const [formData, setFormData] = useState({
    username: '',  // Will be derived from email during registration
    email: '',
    password: '',
    confirmPassword: ''
  });
  const [error, setError] = useState('');
  const [successMessage, setSuccessMessage] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [isUserLocked, setIsUserLocked] = useState(false);
  const [lockoutTime, setLockoutTime] = useState(0);
  const [failedAttempts, setFailedAttempts] = useState(0);

  const navigate = useNavigate();

  // Check lockout status on component mount
  useEffect(() => {
    if (isLogin) {
      const locked = isLockedOut();
      setIsUserLocked(locked);
      if (locked) {
        const remainingTime = getRemainingLockoutTime();
        setLockoutTime(remainingTime);

        // Update lockout time every minute
        const interval = setInterval(() => {
          const newRemainingTime = getRemainingLockoutTime();
          setLockoutTime(newRemainingTime);

          if (newRemainingTime === 0) {
            setIsUserLocked(false);
            clearInterval(interval);
          }
        }, 60000);

        return () => clearInterval(interval);
      }

      // Update failed attempts count
      setFailedAttempts(getFailedAttempts());
    }
  }, [isLogin]);

  // Validation states
  const [emailError, setEmailError] = useState('');
  const [passwordError, setPasswordError] = useState('');

  // Validate email format (ensure no spaces and proper structure)
  const validateEmail = (email) => {
    // Check for spaces first
    if (/\s/.test(email)) {
      return false;
    }
    // Then validate email structure
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return re.test(email);
  };

  // Validate password strength (min 8 chars + uppercase + lowercase + number + special char)
  const validatePassword = (password) => {
    const hasMinLength = password.length >= 8;
    const hasUppercase = /[A-Z]/.test(password);
    const hasLowercase = /[a-z]/.test(password);
    const hasNumber = /\d/.test(password);
    const hasSpecialChar = /[!@#$%^&*(),.?":{}|<>]/.test(password);
    return hasMinLength && hasUppercase && hasLowercase && hasNumber && hasSpecialChar;
  };

  // Password strength indicator
  const getPasswordStrength = (password) => {
    if (!password) return { label: 'None', score: 0, color: 'text-neutral' };

    let score = 0;
    if (password.length >= 8) score++;
    if (/[A-Z]/.test(password)) score++;
    if (/[a-z]/.test(password)) score++;
    if (/\d/.test(password)) score++;
    if (/[^A-Za-z0-9]/.test(password)) score++;

    if (score <= 1) return { label: 'Weak', score: 1, color: 'text-error' };
    if (score <= 2) return { label: 'Fair', score: 2, color: 'text-warning' };
    if (score <= 3) return { label: 'Good', score: 3, color: 'text-success' };
    return { label: 'Strong', score: 4, color: 'text-success' };
  };

  // Handle input changes with validation
  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData({
      ...formData,
      [name]: value
    });

    // Real-time validation
    if (name === 'email') {
      if (value && (!validateEmail(value) || /\s/.test(value))) {
        setEmailError('Please enter a valid email address (no spaces allowed)');
      } else {
        setEmailError('');
      }
    }

    if (name === 'password') {
      if (value && !validatePassword(value)) {
        setPasswordError('Password must be 8+ chars with uppercase, lowercase, number & special char');
      } else {
        setPasswordError('');
      }
    }
  };

  // Enhanced submit handler with validation
  const handleSubmit = async (e) => {
    e.preventDefault();

    // Check if user is locked out
    if (isLogin && isUserLocked) {
      setError(`Account is locked for ${lockoutTime} minutes due to too many failed attempts`);
      return;
    }

    setIsLoading(true);
    setError('');
    setEmailError('');
    setPasswordError('');

    // Client-side validation
    let isValid = true;
    if (!validateEmail(formData.email)) {
      setEmailError('Please enter a valid email address');
      isValid = false;
    }
    if (!validatePassword(formData.password)) {
      setPasswordError('Password must be 8+ chars with uppercase, lowercase, number & special char');
      isValid = false;
    }
    if (!isLogin && formData.password !== formData.confirmPassword) {
      setError('Passwords do not match');
      isValid = false;
    }

    if (!isValid) {
      setIsLoading(false);
      return;
    }

    // Capture the current mode to ensure correct error handling regardless of state changes during request
    const isSubmittingLogin = isLogin;

    try {
      if (isSubmittingLogin) {
        // Login flow - send as form URL-encoded for OAuth2PasswordRequestForm
        const loginData = new URLSearchParams();
        loginData.append('username', formData.email);  // Use email as the username field for login
        loginData.append('password', formData.password);

        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: loginData
        });

        if (response.ok) {
          const data = await response.json();
          if (data.access_token) {
            // Clear login attempts on successful login
            clearLoginAttempts();
            onLogin(data.access_token);
          }
        } else {
          const errorData = await response.json();
          setError(errorData.detail || 'Invalid email or password');
        }
      } else {
        // Registration flow
        if (formData.password !== formData.confirmPassword) {
          setError('Passwords do not match');
          setIsLoading(false);
          return;
        }

        // Validate all fields before sending to backend
        if (!formData.email || !formData.password) {
          setError('Email and password are required');
          setIsLoading(false);
          return;
        }

        // Validate email format and check for spaces (comprehensive check)
        if (!validateEmail(formData.email)) {
          setError('Please enter a valid email address');
          setIsLoading(false);
          return;
        }

        // Comprehensive space check - check for ANY whitespace characters
        if (/\s/.test(formData.email)) {
          setError('Email address cannot contain spaces or any whitespace characters');
          setIsLoading(false);
          return;
        }

        // Additional validation: ensure email doesn't have leading/trailing whitespace
        if (formData.email !== formData.email.trim()) {
          setError('Email address cannot have leading or trailing spaces');
          setIsLoading(false);
          return;
        }

        // Validate password
        if (!validatePassword(formData.password)) {
          setError('Password must be 8+ chars with uppercase, lowercase, number & special char');
          setIsLoading(false);
          return;
        }

        // Ensure username is valid (at least 3 characters, alphanumeric, underscore, hyphen)
        let validUsername = formData.username || formData.email.split('@')[0];
        if (validUsername.length < 3) {
          // If derived username is too short, create a valid one
          validUsername = formData.email.substring(0, Math.min(17, formData.email.indexOf('@'))) + 'usr'; // Use up to 17 chars from email before @ + 'usr'
          if (validUsername.length < 3) {
            validUsername = 'user' + Math.floor(1000 + Math.random() * 9000); // Generate random username
          }
        }

        // Sanitize username to meet backend requirements (alphanumeric, underscore, hyphen only)
        validUsername = validUsername.replace(/[^a-zA-Z0-9_-]/g, '_');
        if (validUsername.length < 3) {
          validUsername = 'user' + Math.floor(1000 + Math.random() * 9000);
        }

        console.log('Sending registration data:', {
          username: validUsername,
          email: formData.email,
          password: '[HIDDEN]',
          role: 'analyst'
        });

        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            username: validUsername,  // Use validated username
            email: formData.email,
            password: formData.password,
            role: 'analyst'  // Default role for all registrations
          })
        });

        if (response.ok) {
          // Show success message
          setSuccessMessage('Registration Successful');

          // Auto-redirect to login after a short delay
          setTimeout(() => {
            setIsLogin(true); // Switch to login view
            setSuccessMessage(''); // Clear success message
          }, 1500); // 1.5 second delay before redirect
        } else {
          const errorData = await response.json();
          setError(errorData.detail || 'Registration failed');
        }
      }
    } catch (err) {
      console.error('Form submission error:', err); // Log the full error for debugging
      if (isSubmittingLogin) {
        // Handle login error - record failed attempts
        recordFailedAttempt();
        const attempts = getFailedAttempts();
        setError(`Invalid email or password (${attempts}/${MAX_FAILED_ATTEMPTS} attempts)`);
        setFailedAttempts(attempts);
        
        // Check if user is now locked out
        if (attempts >= MAX_FAILED_ATTEMPTS) {
          setIsUserLocked(true);
          setLockoutTime(LOCKOUT_DURATION);
          setError(`Account locked for ${LOCKOUT_DURATION} minutes due to too many failed attempts`);
        }
      } else {
        // Handle registration error - DO NOT record failed attempts for registration
        if (err.response) {
          // Server responded with error
          setError('Registration failed due to server error');
          console.error('Registration error response:', err.response);
        } else if (err.request) {
          // Request made but no response
          setError('Network error: Unable to reach server. Please check your connection.');
          console.error('Registration network error:', err.request);
        } else {
          // Other error
          setError(`Registration failed: ${err.message}`);
          console.error('Registration unexpected error:', err.message);
        }
      }
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="min-h-screen w-full flex items-center justify-center bg-primary p-4">
      <div className="bg-card w-full max-w-md p-8 rounded-2xl shadow-sm border border-theme">
        {/* Logo Area */}
        <div className="text-center mb-8">
          <div className="mx-auto flex items-center justify-center w-12 h-12 rounded-full bg-accent-primary/10 mb-4">
            <div className="w-6 h-6 rounded-full bg-accent-primary"></div>
          </div>
          <h1 className="text-2xl font-bold text-primary">VisSpec</h1>
          <p className="mt-2 text-sm text-secondary">
            {isLogin ? 'Welcome back to VisSpec' : 'Join VisSpec Today'}
          </p>
        </div>

        {/* Segmented Control */}
        <div className="flex bg-surface p-1 rounded-lg mb-6">
          <button
            type="button"
            className={`flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors ${
              isLogin
                ? 'bg-card text-accent-primary shadow-sm'
                : 'text-secondary hover:text-accent-primary'
            }`}
            onClick={() => setIsLogin(true)}
            aria-selected={isLogin}
          >
            Sign In
          </button>
          <button
            type="button"
            className={`flex-1 py-2 px-4 rounded-md text-sm font-medium transition-colors ${
              !isLogin
                ? 'bg-card text-accent-primary shadow-sm'
                : 'text-secondary hover:text-accent-primary'
            }`}
            onClick={() => setIsLogin(false)}
            aria-selected={!isLogin}
          >
            Register
          </button>
        </div>

        {/* Form */}
        <form className="space-y-5" onSubmit={handleSubmit}>
          {successMessage && (
            <div className="bg-success/10 border border-success/20 text-success px-4 py-3 rounded-md text-sm mb-4" role="alert">
              <span className="block">{successMessage}</span>
            </div>
          )}

          {error && (
            <div className="bg-error/10 border border-error/20 text-error px-4 py-3 rounded-md text-sm" role="alert">
              <span className="block">{typeof error === 'string' ? error : error.detail || 'An error occurred'}</span>
            </div>
          )}

          {isUserLocked && (
            <div className="bg-warning/10 border border-warning/20 text-warning px-4 py-3 rounded-md text-sm" role="alert">
              <span className="block">Account locked for {lockoutTime} minutes due to too many failed attempts</span>
            </div>
          )}

          {isLogin ? (
            <div>
              <label htmlFor="email" className="block text-sm font-medium text-primary mb-1">
                Email Address
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autoComplete="email"
                required
                className={`w-full px-4 py-3 rounded-lg border ${
                  emailError ? 'border-error bg-error/5' : 'border-theme bg-surface'
                } focus:ring-2 focus:ring-accent-primary focus:bg-card outline-none transition-all`}
                placeholder="Enter your email"
                value={formData.email}
                onChange={handleInputChange}
                aria-invalid={!!emailError}
                aria-describedby={emailError ? "email-error" : undefined}
              />
              {emailError && (
                <p id="email-error" className="mt-1 text-sm text-error">
                  {emailError}
                </p>
              )}
            </div>
          ) : (
            <>
              <div>
                <label htmlFor="email" className="block text-sm font-medium text-primary mb-1">
                  Email Address
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autoComplete="email"
                  required={!isLogin}
                  className={`w-full px-4 py-3 rounded-lg border ${
                    emailError ? 'border-error bg-error/5' : 'border-theme bg-surface'
                  } focus:ring-2 focus:ring-accent-primary focus:bg-card outline-none transition-all`}
                  placeholder="Enter your email"
                  value={formData.email}
                  onChange={handleInputChange}
                  aria-invalid={!!emailError}
                  aria-describedby={emailError ? "email-error" : undefined}
                />
                {emailError && (
                  <p id="email-error" className="mt-1 text-sm text-error">
                    {emailError}
                  </p>
                )}
              </div>

              <div>
                <label htmlFor="username" className="block text-sm font-medium text-primary mb-1">
                  Username
                </label>
                <input
                  id="username"
                  name="username"
                  type="text"
                  autoComplete="username"
                  required={!isLogin}
                  className="w-full px-4 py-3 rounded-lg border border-theme bg-surface focus:ring-2 focus:ring-accent-primary focus:bg-card outline-none transition-all"
                  placeholder="Choose a username"
                  value={formData.username}
                  onChange={handleInputChange}
                />
              </div>
            </>
          )}

          <div>
            <label htmlFor="password" className="block text-sm font-medium text-primary mb-1">
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autoComplete={isLogin ? "current-password" : "new-password"}
              required
              className={`w-full px-4 py-3 rounded-lg border ${
                passwordError ? 'border-error bg-error/5' : 'border-theme bg-surface'
              } focus:ring-2 focus:ring-accent-primary focus:bg-card outline-none transition-all`}
              placeholder="Enter your password"
              value={formData.password}
              onChange={handleInputChange}
              aria-invalid={!!passwordError}
              aria-describedby={passwordError ? "password-error" : undefined}
            />

            {/* Password Strength Indicator - only show during registration */}
            {!isLogin && (
              <div className="mt-2">
                <div className="flex items-center justify-between text-xs text-secondary mb-1">
                  <span>Password strength:</span>
                  <span className={(getPasswordStrength(formData.password).color || 'text-neutral').replace('bg-', 'text-').replace('success', 'success').replace('warning', 'warning').replace('error', 'error')}>
                    {getPasswordStrength(formData.password).label || 'None'}
                  </span>
                </div>
                <div className="w-full bg-theme rounded-full h-1.5">
                  <div
                    className={`h-1.5 rounded-full ${(getPasswordStrength(formData.password).color || 'bg-neutral').replace('bg-', 'bg-')}`}
                    style={{ width: `${(getPasswordStrength(formData.password).score || 0) / 4 * 100}%` }}
                  ></div>
                </div>
              </div>
            )}

            {passwordError && (
              <p id="password-error" className="mt-1 text-sm text-error">
                {passwordError}
              </p>
            )}
          </div>

          {!isLogin && (
            <div>
              <label htmlFor="confirmPassword" className="block text-sm font-medium text-primary mb-1">
                Confirm Password
              </label>
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                autoComplete="new-password"
                required={!isLogin}
                className={`w-full px-4 py-3 rounded-lg border ${
                  formData.password !== formData.confirmPassword && formData.confirmPassword
                    ? 'border-error bg-error/5' : 'border-theme bg-surface'
                } focus:ring-2 focus:ring-accent-primary focus:bg-card outline-none transition-all`}
                placeholder="Confirm your password"
                value={formData.confirmPassword}
                onChange={handleInputChange}
              />
              {formData.password !== formData.confirmPassword && formData.confirmPassword && (
                <p className="mt-1 text-sm text-error">
                  Passwords do not match
                </p>
              )}
            </div>
          )}

          {/* Role dropdown removed - only analyst/developer can register, supervisor logs in */}

          <div>
            <button
              type="submit"
              disabled={isLoading}
              className={`w-full py-3 rounded-lg text-white font-medium transition-all ${
                isLoading
                  ? 'bg-accent-primary/50 cursor-not-allowed'
                  : 'bg-accent-primary hover:bg-accent-secondary'
              }`}
            >
              {isLoading
                ? (isLogin ? 'Signing in...' : 'Creating account...')
                : (isLogin ? 'Sign in' : 'Create Account')}
            </button>
          </div>

          {isLogin && (
            <div className="text-right text-sm mt-2">
              <button
                onClick={() => navigate('/forgot-password')}
                className="text-accent-primary hover:text-accent-secondary font-medium"
              >
                Forgot Password?
              </button>
            </div>
          )}
        </form>

        {isLogin && (
          <div className="pt-6 border-t border-theme mt-6">
            <div className="text-center text-sm text-secondary">
              <p>Don't have an account? <button
                onClick={() => setIsLogin(false)}
                className="text-accent-primary hover:text-accent-secondary font-medium"
              >
                Register here
              </button></p>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default LoginPage;