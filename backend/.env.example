# VisSpec Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://vispec:vispec123@localhost:5432/visspec

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM provider (profiles defined in backend/core/config.py)
#   groq-gpt-oss-120b : Groq, key required (default)
#   ovh-llama33-70b   : OVHcloud AI Endpoints anonymous tier, no key required
# LLM_BASE_URL / LLM_MODEL below OVERRIDE the profile defaults when set.
LLM_PROFILE=groq-gpt-oss-120b
LLM_API_KEY=
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=openai/gpt-oss-120b

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_REASONING_EFFORT=low

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Document Limits
MAX_FILE_SIZE_BYTES=10485760
MAX_PAGES=50
MAX_PROCESSING_TIME_MS=180000

# Validation
MIN_CONFIDENCE_THRESHOLD=0.70

# Report
REPORT_WATERMARK=VisSpec
