# VisSpec Environment Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://vispec:vispec123@localhost:5432/visspec

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq API (LLaMA 3)
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GROQ_TEMPERATURE=0.1
GROQ_MAX_RETRIES=3

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Document Limits
MAX_FILE_SIZE_BYTES=10485760
MAX_PAGES=50
MAX_PROCESSING_TIME_MS=180000

# Validation
MIN_CONFIDENCE_THRESHOLD=0.70

# Report
REPORT_WATERMARK=VisSpec
